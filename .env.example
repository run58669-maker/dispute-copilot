# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# Both absent: the app runs in mock mode on fixtures/disputes.json.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# MODE=mock forces the sample disputes even if PayPal keys are set (used for the public demo).
MODE=

# Any OpenAI-compatible chat endpoint. Absent: a deterministic template drafter is used.
# Default below is Google Gemini's free tier via its OpenAI-compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
# Tried in order after LLM_MODEL when a model is out of quota (429) or not found. Free-tier quotas are per model.
LLM_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3.5-flash-lite

PORT=3000

# Shared secret for Approve & send (header x-admin-token). Leave empty for a read-only server (public demo).
ADMIN_TOKEN=
