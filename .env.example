# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# Both absent: the app runs in mock mode on fixtures/disputes.json.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# MODE=mock forces the sample disputes even if PayPal keys are set (used for the public demo).
MODE=

# Any OpenAI-compatible chat endpoint. Absent: a deterministic template drafter is used.
# Default below is Google Gemini's free tier via its OpenAI-compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

PORT=3000
